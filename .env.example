# --- AWS Bedrock (Pydantic AI) ---
# Use EITHER the Bedrock API key below OR the IAM access key + secret (not both)
# Bedrock API key (long-term or short-term), read by boto3 as a bearer token
# AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Bedrock model ID for the tutor agent (read via ai_gateway model_id_variable)
TUTOR_MODEL_ID=mistral.mistral-large-3-675b-instruct

# --- Postgres / Supabase ---
POSTGRES_DB=futureed
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Supabase client (only if using the Supabase API / hosted project) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Storage ---
# memory = in-memory history store (run ONE backend worker); postgres arrives at M5
STORAGE=memory
# Load the seeded demo history at startup (memory store only). Restarting resets the demo.
AUTOSEED=true

# --- Offline demo (F27) ---
# DEMO_MODE=offline plays the saved Maria and Nikos story with no network, no credentials and no AI,
# even when TUTOR_MODEL_ID is set above. Leave it empty for the real tutor. Then: docker compose up -d backend
DEMO_MODE=

# --- Frontend addresses allowed to call the API (CORS) ---
# Comma separated; replaces the local default (http://localhost:3000 and http://127.0.0.1:3000).
# Set it to the deployed frontend's address. A wildcard (*) is refused. Then: docker compose up -d backend
CORS_ORIGINS=

# --- Development session trace ---
# Record a structured trace of every session (GET /api/debug-trace). Development only: the trace holds hidden
# solutions and drafts, so never enable it on a public deployment. The local Docker stack turns it on unless
# this is set to false; the backend run any other way keeps it off unless this is true.
# DEBUG_TRACE=false
