# --- AWS Bedrock (Pydantic AI) ---
# Use EITHER the Bedrock API key below OR the IAM access key + secret (not both)
# Bedrock API key (long-term or short-term), read by boto3 as a bearer token
# AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# --- Postgres / Supabase ---
POSTGRES_DB=futureed
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Supabase client (only if using the Supabase API / hosted project) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Storage ---
# memory = in-memory history store (run ONE backend worker); postgres arrives at M5
STORAGE=memory
# Load the seeded demo history at startup (memory store only). Restarting resets the demo.
AUTOSEED=true
